#include <stdio.h>

int main()
{
    int i, j, k;
    int array[6];
    int greater = 0, lesser = 0;

    for (i = 0; i < 4; i++)
    {
        printf("enter the number %d: ", i + 1);
        scanf("%d", &array[i]);
        printf("%d\n", array[i]);
    }

    for (i = 0; i < 4; i++)
    {
        for (j = 0; j < 4; j++)
        {
            if (array[i] >= array[j])
            {
                greater = 1;
            }
            else
            {
                greater = 0;
                break;
            }
        }

        if (greater == 1)
        {
            printf("%d is greater number\n", array[i]);
        }
    }

    for (i = 0; i < 4; i++)
    {
        for (j = 0; j < 4; j++)
        {
            if (array[i] <= array[j])
            {
                lesser = 1;
            }
            else
            {
                lesser = 0;
                break;
            }
        }

        if (lesser == 1)
        {
            printf("%d is lesser number\n", array[i]);
        }
    }

    int search_num;

    printf("the number which you want to search:\n");
    scanf("%d", &search_num);

    for (i = 0; i < 4; i++)
    {
        if (array[i] == search_num)
        {
            printf("%d is the index of your number.\n", i);
        }
    }

    int index, no;

    printf("enter the index and number where you want to add the num:\n");
    scanf("%d %d", &index, &no);

    for (i = 4; i > index; i--)
    {
        array[i] = array[i - 1];
    }

    array[index] = no;

    for (i = 0; i < 5; i++)
    {
        printf("%d\t", array[i]);
    }

    return 0;
}
